{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@lynx-js/types", "@lynx-js/react"]
  },
  "include": ["src", "scripts", "host", "*.ts", "*.mjs"]
}
